# Qigsaw dynamic feature splits
allow platform_app_36 app_data_file:file execute;

# Algorithm libraries offloading to the DSPs
allow platform_app_36 adsprpcd_file:dir { open read search };
allow platform_app_36 vendor_xdsp_device:chr_file { ioctl open read write };

# Properties
get_prop(platform_app_36, vendor_audio_prop)
get_prop(platform_app_36, vendor_camera_prop)
get_prop(platform_app_36, vendor_display_prop)
get_prop(platform_app_36, vendor_fp_prop)
