 .../miuix_preference_widget_switch_compat.xml |  2 +-
 res/layout/more_mode_style_settings.xml       |  4 +--
 res/values/styles.xml                         | 30 ++++++++-----------
 10 files changed, 21 insertions(+), 28 deletions(-)

