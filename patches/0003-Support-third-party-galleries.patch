+    const-string v5, "android.intent.category.APP_GALLERY"
 
     const-string v6, "com.android.camera.action.REVIEW"
 
@@ -1121,9 +1121,7 @@
 
     invoke-direct {v2, v6, v1}, Landroid/content/Intent;-><init>(Ljava/lang/String;Landroid/net/Uri;)V
 
